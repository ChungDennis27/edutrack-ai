# EduTrack AI — Environment Variables (copy to .env and fill in values)
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edutrack_ai
# LLM — OpenAI-compatible endpoint. TeamoRouter example:
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.teamorouter.com/v1
LLM_API_KEY=your-teamo-router-api-key-here
LLM_MODEL=deepseek-flash-free
# Optional native Anthropic fallback (use LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
FLASK_ENV=development
CHROMA_PERSIST_DIR=./app/data/chroma_store
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
